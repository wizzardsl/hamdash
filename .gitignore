# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
# PyInstaller writes a .spec when you run it without one; ours is hand-written
# and is the build definition, so it is tracked.
*.spec
!hamdash.spec

# Virtualenvs
.venv/
venv/
env/

# hamdash runtime state — config dirs created by --home / HAMDASH_HOME.
# dev*/ rather than dev/: throwaway homes get numbered when you want two
# boards side by side, and dev2/ nearly got committed.
dev*/
*-home/
*.log
hamdash.log

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Claude Code local settings (keep .claude/settings.json, drop the local one)
.claude/settings.local.json

# A note for picking the work up on another machine: describes this
# station and its accounts, so it stays local and out of the public repo.
HANDOFF.md
